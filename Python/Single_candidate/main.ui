<?xml version='1.0' encoding='utf-8'?>
<interface>
  <object class="tk.Toplevel" id="mainwindow">
    <property name="resizable">both</property>
    <property name="title" translatable="yes">MOLO</property>
    <child>
      <object class="ttk.Frame" id="mw_fcontainer">
        <property name="height">600</property>
        <property name="width">800</property>
        <layout>
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">0</property>
          <property name="sticky">nsew</property>
          <rows>
            <row id="1">
              <property name="weight">1</property>
            </row>
          </rows>
          <columns>
            <column id="0">
              <property name="weight">1</property>
            </column>
          </columns>
        </layout>
        <child>
          <object class="ttk.Frame" id="mw_ftoolbar">
            <property name="borderwidth">2</property>
            <property name="height">20</property>
            <property name="width">200</property>
            <layout>
              <property name="column">0</property>
              <property name="propagate">True</property>
              <property name="row">0</property>
              <property name="sticky">nsew</property>
            </layout>
            <child>
              <object class="ttk.Menubutton" id="mm_file">
                <property name="text" translatable="yes">File</property>
                <layout>
                  <property name="column">0</property>
                  <property name="propagate">True</property>
                  <property name="row">0</property>
                </layout>
                <child>
                  <object class="tk.Menu" id="mm_file_menu">
                    <child>
                      <object class="tk.Menuitem.Command" id="mm_analyses_root">
                        <property name="command">open_workspace</property>
                        <property name="command_id_arg">false</property>
                        <property name="label" translatable="yes">Open Workspace</property>
                      </object>
                    </child>
                    <child>
                      <object class="tk.Menuitem.Separator" id="Separator_1" />
                    </child>
                    <child>
                      <object class="tk.Menuitem.Command" id="mm_quit">
                        <property name="command">quit</property>
                        <property name="command_id_arg">false</property>
                        <property name="label" translatable="yes">Quit</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Menubutton" id="mm_help">
                <property name="text" translatable="yes">Help</property>
                <layout>
                  <property name="column">1</property>
                  <property name="propagate">True</property>
                  <property name="row">0</property>
                  <property name="sticky">ne</property>
                </layout>
                <child>
                  <object class="tk.Menu" id="mm_help_menu">
                    <child>
                      <object class="tk.Menuitem.Command" id="mm_about">
                        <property name="command">show_about_dialog</property>
                        <property name="command_id_arg">false</property>
                        <property name="label" translatable="yes">About</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Notebook" id="mw_fnotebook">
            <layout>
              <property name="column">0</property>
              <property name="propagate">True</property>
              <property name="row">1</property>
              <property name="sticky">nsew</property>
            </layout>
            <child>
              <object class="ttk.Notebook.Tab" id="mw_main_tab">
                <property name="text" translatable="yes">Main</property>
                <child>
                  <object class="ttk.Frame" id="main_frame">
                    <property name="borderwidth">20</property>
                    <property name="padding">0</property>
                    <property name="relief">groove</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="propagate">True</property>
                      <property name="row">0</property>
                      <rows>
                        <row id="0">
                          <property name="pad">10</property>
                        </row>
                        <row id="1">
                          <property name="pad">10</property>
                        </row>
                      </rows>
                      <columns>
                        <column id="0">
                          <property name="pad">10</property>
                        </column>
                        <column id="1">
                          <property name="pad">10</property>
                        </column>
                      </columns>
                    </layout>
                    <child>
                      <object class="ttk.Label" id="analyses_root_label">
                        <property name="text" translatable="yes">Analysis root</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">0</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Entry" id="analyses_root_input">
                        <property name="text" translatable="yes">C:\mdo_working_dir</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="propagate">True</property>
                          <property name="row">0</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Label" id="park_label_label">
                        <property name="text" translatable="yes">Park label</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">1</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Entry" id="park_label_input">
                        <property name="text" translatable="yes">site_01</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="propagate">True</property>
                          <property name="row">1</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Label" id="wtg_label_label">
                        <property name="text" translatable="yes">WTG label</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="pady">10</property>
                          <property name="propagate">True</property>
                          <property name="row">2</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Entry" id="wtg_label_input">
                        <property name="text" translatable="yes">test</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="propagate">True</property>
                          <property name="row">2</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Notebook.Tab" id="mw_model_tab">
                <property name="text" translatable="yes">Model</property>
                <child>
                  <object class="ttk.Frame" id="model_frame">
                    <property name="height">200</property>
                    <property name="relief">raised</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="propagate">True</property>
                      <property name="row">0</property>
                      <rows>
                        <row id="1">
                          <property name="weight">1</property>
                        </row>
                      </rows>
                      <columns>
                        <column id="0">
                          <property name="weight">1</property>
                        </column>
                      </columns>
                    </layout>
                    <child>
                      <object class="ttk.Frame" id="model_top_frame">
                        <property name="borderwidth">5</property>
                        <property name="height">200</property>
                        <property name="relief">groove</property>
                        <property name="width">200</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">0</property>
                          <property name="sticky">nsew</property>
                          <rows>
                            <row id="0">
                              <property name="weight">1</property>
                            </row>
                          </rows>
                          <columns>
                            <column id="0">
                              <property name="weight">1</property>
                            </column>
                            <column id="1">
                              <property name="weight">1</property>
                            </column>
                          </columns>
                        </layout>
                        <child>
                          <object class="ttk.Frame" id="model_parameters_frame">
                            <property name="borderwidth">5</property>
                            <property name="height">200</property>
                            <property name="width">200</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">ew</property>
                            </layout>
                            <child>
                              <object class="ttk.Label" id="ncol_label">
                                <property name="text" translatable="yes">Number of columns per wing</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="ncol_input">
                                <property name="text" translatable="yes">2</property>
                                <property name="width">20</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Label" id="column_diameter_label">
                                <property name="text" translatable="yes">Diameter [m]</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">1</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="column_diameter_input">
                                <property name="text" translatable="yes">7.8</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">1</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Label" id="height_label">
                                <property name="text" translatable="yes">Height[m]</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">2</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="height_input">
                                <property name="text" translatable="yes">20</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">2</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Label" id="gap_label">
                                <property name="text" translatable="yes">Gap factor</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">3</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="gap_input">
                                <property name="text" translatable="yes">1.1</property>
                                <property name="textvariable">double:test</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">3</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="ttk.Frame" id="model_execution_frame">
                            <property name="height">200</property>
                            <property name="width">200</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">ew</property>
                              <columns>
                                <column id="0">
                                  <property name="weight">0</property>
                                </column>
                              </columns>
                            </layout>
                            <child>
                              <object class="ttk.Button" id="model_run_button">
                                <property name="command">create_model</property>
                                <property name="text" translatable="yes">Run</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Frame" id="model_text_box_frame">
                        <property name="borderwidth">3</property>
                        <property name="relief">sunken</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">1</property>
                          <property name="sticky">nsew</property>
                          <rows>
                            <row id="0">
                              <property name="weight">1</property>
                            </row>
                          </rows>
                          <columns>
                            <column id="0">
                              <property name="weight">1</property>
                            </column>
                          </columns>
                        </layout>
                        <child>
                          <object class="tk.Text" id="model_text">
                            <property name="borderwidth">0</property>
                            <property name="height">24</property>
                            <property name="state">normal</property>
                            <property name="text" translatable="yes">Press run to generate model</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">nsew</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Notebook.Tab" id="mw_stability_tab">
                <property name="sticky">nsew</property>
                <property name="text" translatable="yes">Stability</property>
                <child>
                  <object class="ttk.Frame" id="stability_frame">
                    <layout>
                      <property name="column">0</property>
                      <property name="propagate">True</property>
                      <property name="row">0</property>
                      <rows>
                        <row id="1">
                          <property name="weight">1</property>
                        </row>
                      </rows>
                      <columns>
                        <column id="0">
                          <property name="weight">1</property>
                        </column>
                      </columns>
                    </layout>
                    <child>
                      <object class="ttk.Frame" id="stability_top_frame">
                        <property name="height">200</property>
                        <property name="width">200</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">0</property>
                          <property name="sticky">new</property>
                        </layout>
                        <child>
                          <object class="ttk.Frame" id="stability_input_frame">
                            <property name="relief">groove</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">nsew</property>
                            </layout>
                            <child>
                              <object class="ttk.Checkbutton" id="stability_movie_chkbtn">
                                <property name="text" translatable="yes">Make stability movie</property>
                                <property name="variable">boolean:stability_movie_chkbtn_var</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="ttk.Frame" id="stability_execution_frame">
                            <layout>
                              <property name="column">1</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">nsew</property>
                            </layout>
                            <child>
                              <object class="ttk.Button" id="calc_stability_button">
                                <property name="command">calc_stability</property>
                                <property name="text" translatable="yes">Run</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Frame" id="stability_text_box_frame">
                        <property name="borderwidth">3</property>
                        <property name="relief">sunken</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">1</property>
                          <property name="sticky">nsew</property>
                          <rows>
                            <row id="0">
                              <property name="weight">1</property>
                            </row>
                          </rows>
                          <columns>
                            <column id="0">
                              <property name="weight">1</property>
                            </column>
                          </columns>
                        </layout>
                        <child>
                          <object class="tk.Text" id="stability_text">
                            <property name="borderwidth">0</property>
                            <property name="pady">0</property>
                            <property name="state">normal</property>
                            <property name="text" translatable="yes">Press run to calculate stability</property>
                            <property name="width">80</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">nsew</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Notebook.Tab" id="mw_hydro_tab">
                <property name="sticky">nsew</property>
                <property name="text" translatable="yes">Hydro</property>
                <child>
                  <object class="ttk.Frame" id="hydro_frame">
                    <layout>
                      <property name="column">0</property>
                      <property name="propagate">True</property>
                      <property name="row">0</property>
                      <rows>
                        <row id="1">
                          <property name="weight">1</property>
                        </row>
                      </rows>
                      <columns>
                        <column id="0">
                          <property name="weight">1</property>
                        </column>
                      </columns>
                    </layout>
                    <child>
                      <object class="ttk.Frame" id="hydro_top_frame">
                        <property name="borderwidth">5</property>
                        <property name="height">200</property>
                        <property name="relief">groove</property>
                        <property name="width">200</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="propagate">True</property>
                          <property name="row">0</property>
                          <property name="sticky">nsew</property>
                          <rows>
                            <row id="0">
                              <property name="weight">1</property>
                            </row>
                          </rows>
                          <columns>
                            <column id="0">
                              <property name="weight">1</property>
                            </column>
                            <column id="1">
                              <property name="weight">1</property>
                            </column>
                          </columns>
                        </layout>
                        <child>
                          <object class="ttk.Frame" id="hydro_parameters_frame">
                            <property name="borderwidth">5</property>
                            <property name="height">200</property>
                            <property name="width">200</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="propagate">True</property>
                              <property name="row">0</property>
                              <property name="sticky">ew</property>
                            </layout>
                            <child>
                              <object class="ttk.Label" id="num_wave_frequencies_label">
                                <property name="text" translatable="yes">Number of wave freq.</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="num_wave_frequencies_input">
                                <property name="width">20</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">0</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Label" id="min_wave_frequencies_label">
                                <property name="text" translatable="yes">Min. wave freq.</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">1</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="min_wave_frequencies_input">
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">1</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Label" id="max_wave_frequencies_label">
                                <property name="text" translatable="yes">Max wave freq.</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">2</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="max_wave_frequencies_input">
                                <layout>
                                  <property name="column">1</property>
                                  <property name="ipadx">20</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">2</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Label" id="num_wave_directions_label">
                                <property name="text" translatable="yes">Number of wave dir.</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="ipadx">10</property>
                                  <property name="pady">10</property>
                                  <property name="propagate">True</property>
                                  <property name="row">3</property>
                                  <property name="sticky">w</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="num_wave_directions_input">
                                <layout>
